# Copy to .env and replace only values needed by your environment.
SHIP_KAFKA_BROKERS=localhost:29092
SHIP_DATABASE_URL=postgresql://ship:ship_dev_password@localhost:5432/ship
SHIP_AISSTREAM_API_KEY=
SHIP_LOG_LEVEL=INFO
SHIP_API_TOKEN=dev-api-token-change-me

# Required: generate with e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SHIP_JWT_SECRET=replace-with-a-strong-secret-at-least-32-chars-long

# Stream processor
SHIP_CHECKPOINT_DIR=/opt/ship/checkpoints
SHIP_KAFKA_STARTING_OFFSET=latest
SHIP_ENABLE_PREDICTION=false

# Kafka security (PLAINTEXT for local dev)
SHIP_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SHIP_PG_SSLMODE=prefer

# LLM provider (ollama | transformers | openai-compatible)
SHIP_LLM_PROVIDER=ollama
SHIP_LLM_MODEL=qwen2.5:3b
SHIP_LLM_BASE_URL=http://localhost:11434