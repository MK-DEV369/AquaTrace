# Copy to .env and replace only values needed by your environment.
SHIP_KAFKA_BROKERS=localhost:29092
SHIP_DATABASE_URL=postgresql://ship:ship_dev_password@localhost:5433/ship
SHIP_AISSTREAM_API_KEY=
# Live source (Miami, FL): min_lat,min_lon,max_lat,max_lon. Never expose this key in a browser.
SHIP_AISSTREAM_BBOX=25.603,-80.208,25.835,-79.879
# aisstream (live default), static (one-day local dataset), or replay (six-event sample)
SHIP_EVENT_SOURCE=aisstream
SHIP_STATIC_VESSELS=1000
SHIP_STATIC_RATE=200
SHIP_LOG_LEVEL=INFO
SHIP_API_TOKEN=dev-api-token-change-me

# Required: generate with e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SHIP_JWT_SECRET=replace-with-a-strong-secret-at-least-32-chars-long

# Stream processor
SHIP_CHECKPOINT_DIR=checkpoints
SHIP_KAFKA_STARTING_OFFSET=earliest
SHIP_ENABLE_PREDICTION=false

# Kafka security (PLAINTEXT for local dev)
SHIP_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SHIP_PG_SSLMODE=prefer

# LLM provider (ollama | transformers | openai-compatible)
SHIP_LLM_PROVIDER=ollama
SHIP_LLM_MODEL=qwen2.5:3b
# Docker uses host.docker.internal to reach an Ollama server running on the host.
SHIP_LLM_BASE_URL=http://host.docker.internal:11434
